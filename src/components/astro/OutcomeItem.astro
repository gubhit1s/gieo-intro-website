---
/** One course learning outcome (FR-018). The icon is decorative (FR-027). */
import type { CourseOutcome } from '~/content/types';
import Sprout from '~/assets/svg/plants/Sprout.astro';
import LeafPair from '~/assets/svg/plants/LeafPair.astro';
import GrassTuft from '~/assets/svg/plants/GrassTuft.astro';
import FallingSeed from '~/assets/svg/plants/FallingSeed.astro';

interface Props {
  outcome: CourseOutcome;
}

const { outcome } = Astro.props;

const icons = {
  sprout: Sprout,
  'leaf-pair': LeafPair,
  'grass-tuft': GrassTuft,
  'falling-seed': FallingSeed,
} as const;

const Icon = outcome.icon ? icons[outcome.icon] : Sprout;
---

<li
  class="flex items-start gap-4 rounded-xl border border-sprout-200 bg-white p-5 sm:p-6"
>
  <span
    aria-hidden="true"
    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-sun-100 text-sprout-600"
  >
    <Icon size={22} />
  </span>
  <span class="pt-1.5 text-sm leading-relaxed text-ink sm:text-base">{outcome.text}</span>
</li>
