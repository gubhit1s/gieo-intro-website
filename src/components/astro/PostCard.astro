---
/**
 * One post in the library grid (/tai-lieu, and "more posts" under a post).
 * The whole card is the link. Same serif title → summary structure as
 * MaterialCard on the home page, but boxed, because a grid needs edges.
 */
import { site } from '~/content/site';
import type { MaterialEntry } from '~/content/types';

interface Props {
  entry: MaterialEntry;
  /** Heading level for the title, so it nests correctly on each page. */
  headingLevel?: 'h2' | 'h3';
}

const { entry, headingLevel: Heading = 'h2' } = Astro.props;
---

<a
  href={entry.href}
  class="group flex h-full flex-col rounded-3xl bg-white/80 p-7 shadow-sm ring-1 ring-sprout-200/70 transition hover:shadow-md motion-safe:hover:-translate-y-0.5 sm:p-8"
>
  <Heading class="font-serif text-2xl font-medium leading-snug text-sprout-900 decoration-sprout-300 decoration-2 underline-offset-[6px] group-hover:underline group-focus-visible:underline">
    {entry.title}
  </Heading>
  <p class="mt-3 flex-1 leading-relaxed text-ink-muted">{entry.description}</p>
  <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-sprout-700">
    {site.materials.readLabel}
    <span aria-hidden="true" class="transition-transform motion-safe:group-hover:translate-x-0.5">
      →
    </span>
  </span>
</a>
