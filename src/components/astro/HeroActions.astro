---
/**
 * The two hero buttons. Plain in-page anchors, so they work with no
 * JavaScript; smooth scrolling and the sticky-header offset come from
 * global.css. Icons are decorative — the label is the accessible name.
 *
 * First action is primary (sprout), second is secondary (sun).
 */
import { site } from '~/content/site';

const [primary, secondary] = site.hero.actions;

const base =
  'inline-flex w-full max-w-xs items-center justify-center gap-2.5 rounded-full px-6 py-3 ' +
  'text-base font-semibold shadow-sm transition sm:w-auto sm:max-w-none ' +
  'motion-safe:hover:-translate-y-0.5 motion-safe:active:translate-y-0';

const actions = [
  { ...primary, class: `${base} bg-sprout-700 text-white hover:bg-sprout-800` },
  {
    ...secondary,
    class: `${base} bg-sun-300 text-bark-800 ring-1 ring-sun-400/70 hover:bg-sun-400`,
  },
];
---

<div class="flex w-full flex-col items-center justify-center gap-3 sm:flex-row sm:gap-4">
  {
    actions.map((action) => (
      <a href={action.href} class={action.class}>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="20"
          height="20"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
          class="shrink-0"
        >
          {action.icon === 'compass' ? (
            <>
              <circle cx="12" cy="12" r="10" />
              <path d="m16.24 7.76-2.12 6.36-6.36 2.12 2.12-6.36z" fill="currentColor" fill-opacity="0.25" />
            </>
          ) : (
            <>
              {/* Presenter at a board, two people listening. */}
              <path d="M3 3h18" />
              <path d="M4 3v8a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V3" />
              <path d="M8 7l3 2 4-3" />
              <circle cx="7" cy="16.5" r="1.8" />
              <circle cx="17" cy="16.5" r="1.8" />
              <path d="M3.5 22a3.5 3.5 0 0 1 7 0" />
              <path d="M13.5 22a3.5 3.5 0 0 1 7 0" />
            </>
          )}
        </svg>
        <span>{action.label}</span>
      </a>
    ))
  }
</div>
