---
/**
 * The two hero buttons. Plain in-page anchors, so they work with no
 * JavaScript; smooth scrolling and the sticky-header offset come from
 * global.css. Icons are decorative — the label is the accessible name.
 *
 * First action is primary (sprout), second is secondary (sun).
 */
import { site } from '~/content/site';

const [primary, secondary] = site.hero.actions;

const base =
  // Labels may wrap on the narrowest phones (the talkshow label is long);
  // from 640px they stay on one line.
  'inline-flex w-full max-w-xs items-center justify-center gap-2.5 text-balance rounded-full px-6 py-3 text-center sm:whitespace-nowrap ' +
  'text-base font-semibold shadow-sm transition sm:w-auto sm:max-w-none ' +
  'motion-safe:hover:-translate-y-0.5 motion-safe:active:translate-y-0';

const actions = [
  { ...primary, class: `${base} bg-sprout-700 text-white hover:bg-sprout-800` },
  {
    ...secondary,
    class: `${base} bg-sun-300 text-bark-800 ring-1 ring-sun-400/70 hover:bg-sun-400`,
  },
];
---

<div class="flex w-full flex-col items-center justify-center gap-3 sm:flex-row sm:flex-wrap sm:gap-4 xl:justify-start xl:gap-3">
  {actions.map((action) => (
    <a href={action.href} class={action.class}>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
        class="shrink-0"
      >
        {action.icon === 'book' ? (
          <>
            {/* Open book. */}
            <path d="M12 7v14" />
            <path
              d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"
              fill="currentColor"
              fill-opacity="0.15"
            />
          </>
        ) : (
          <>
            {/* Microphone on a stand. */}
            <rect
              x="9"
              y="2"
              width="6"
              height="12"
              rx="3"
              fill="currentColor"
              fill-opacity="0.25"
            />
            <path d="M19 10v1a7 7 0 0 1-14 0v-1" />
            <path d="M12 18v4" />
            <path d="M8 22h8" />
          </>
        )}
      </svg>
      <span>{action.label}</span>
    </a>
  ))}
</div>
