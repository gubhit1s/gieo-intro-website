---
/**
 * One talkshow host or speaker, as a card in the TalkshowSection carousel:
 * portrait in a tilted polaroid frame, role chip, name, headline credential,
 * then every achievement.
 *
 * Achievements render in FULL — no line-clamp, ellipsis or expand/collapse.
 * They are public claims about a real person's results, so none may be hidden
 * behind an interaction (same rule as the old team cards, FR-012).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { TalkshowSpeaker } from '~/content/types';
import Sprout from '~/assets/svg/plants/Sprout.astro';

interface Props {
  speaker: TalkshowSpeaker;
  portrait: ImageMetadata;
  /** Resting tilt of the polaroid frame in degrees; it straightens on hover. */
  tilt: number;
}

const { speaker, portrait, tilt } = Astro.props;
const isHost = speaker.role === 'Host';
---

<article class="group flex h-full flex-col rounded-3xl bg-white/90 p-5 shadow-sm ring-1 ring-sprout-200/80 transition-shadow hover:shadow-lg hover:shadow-sprout-900/10">
  <div
    class="talkshow-polaroid mx-auto w-full max-w-[10rem] bg-white p-2 pb-3 shadow-md shadow-sprout-900/15 ring-1 ring-bark-100"
    style={`--tilt: ${tilt}deg`}
  >
    <Picture
      src={portrait}
      alt={speaker.portraitAlt}
      formats={['avif', 'webp']}
      widths={[200, 400]}
      sizes="10rem"
      loading="lazy"
      class="aspect-square w-full object-cover"
    />
  </div>

  <div class="mt-5 flex flex-col items-center text-center">
    <p
      class:list={[
        'rounded-full px-3.5 py-1.5 text-xs font-semibold uppercase leading-normal tracking-[0.14em]',
        isHost ? 'bg-sun-300 text-bark-800' : 'bg-sprout-700 text-white',
      ]}
    >
      {speaker.role}
    </p>
    <h4 class="mt-2 font-serif text-2xl font-semibold italic text-sprout-900">{speaker.name}</h4>
    <p class="mt-2 inline-flex items-center gap-1.5 rounded-xl bg-sun-100 px-3 py-1.5 text-sm font-semibold text-bark-800">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        width="16"
        height="16"
        aria-hidden="true"
        focusable="false"
        class="shrink-0 text-sun-600"
      >
        {/* Medal. */}
        <path d="M7 2h4l1 4-3 3zM17 2h-4l-1 4 3 3z" fill="currentColor" opacity="0.6" />
        <circle cx="12" cy="15" r="6" fill="currentColor" />
      </svg>
      {speaker.highlight}
    </p>
  </div>

  <ul class="mt-4 flex flex-col gap-2 border-t border-sprout-100 pt-4">
    {speaker.achievements.map((achievement) => (
      <li class="flex gap-2 text-sm leading-relaxed text-ink">
        <Sprout size={16} class="mt-1 shrink-0 text-sprout-500" />
        <span>{achievement}</span>
      </li>
    ))}
  </ul>
</article>
