---
/**
 * One post in the home-page grid: cover across the top of a soft panel, serif
 * title, excerpt, then a "read" cue pinned to the bottom so cards in a row
 * line up. The whole card links to the post's page.
 */
import { Picture } from 'astro:assets';
import type { MaterialEntry } from '~/content/types';
import { site } from '~/content/site';

interface Props {
  entry: MaterialEntry;
}

const { entry } = Astro.props;
---

<a
  href={entry.href}
  class="group flex h-full flex-col overflow-hidden rounded-3xl bg-white/70 shadow-sm ring-1 ring-sprout-200/70 transition hover:bg-white hover:shadow-md hover:shadow-sprout-900/10 motion-safe:hover:-translate-y-1"
>
  {/* alt="" because the title already names the link; the post page carries the real alt. */}
  {entry.cover && (
    <Picture
      src={entry.cover.image}
      alt=""
      formats={['avif', 'webp']}
      widths={[400, 800]}
      sizes="(min-width: 1024px) 22rem, (min-width: 640px) 50vw, 100vw"
      class="aspect-video w-full object-cover"
    />
  )}
  <div class="flex flex-1 flex-col p-6">
    <h3 class="font-serif text-xl font-medium leading-snug text-sprout-900 decoration-sprout-300 decoration-2 underline-offset-[6px] group-hover:underline group-focus-visible:underline">
      {entry.title}
    </h3>
    <p class="mt-3 text-base leading-relaxed text-ink-muted">{entry.description}</p>
    <span class="mt-auto pt-5 text-sm font-semibold text-sprout-700">
      {site.materials.readLabel} <span aria-hidden="true">→</span>
    </span>
  </div>
</a>
