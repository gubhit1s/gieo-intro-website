---
/**
 * One post on the home page, styled as an article in a literary publication
 * rather than a boxed card: serif title, then excerpt. The whole entry links
 * to the post's page.
 *
 * `featured` gives the lead article a larger title and a soft panel. The other
 * entries have no border or background at all — whitespace separates them.
 */
import type { MaterialEntry } from '~/content/types';

interface Props {
  entry: MaterialEntry;
  featured?: boolean;
}

const { entry, featured = false } = Astro.props;
---

<a
  href={entry.href}
  class:list={[
    'group flex h-full flex-col',
    featured && 'rounded-3xl bg-white/70 p-8 sm:p-10 lg:p-12',
  ]}
>
  <h3
    class:list={[
      'font-serif font-medium leading-snug text-sprout-900 decoration-sprout-300 decoration-2 underline-offset-[6px] group-hover:underline group-focus-visible:underline',
      featured ? 'text-3xl sm:text-4xl' : 'text-xl sm:text-2xl',
    ]}
  >
    {entry.title}
  </h3>
  <p
    class:list={[
      'text-ink-muted',
      featured ? 'mt-5 max-w-prose text-lg leading-relaxed' : 'mt-2 text-base leading-relaxed',
    ]}
  >
    {entry.description}
  </p>
</a>
