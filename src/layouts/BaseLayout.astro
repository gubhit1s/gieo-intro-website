---
/**
 * Document shell for the Gieo landing site, and the single home for SEO and
 * social-preview metadata: canonical URL, Open Graph / Twitter tags (what
 * Facebook, Zalo and Messenger show when a link is shared) and any
 * structured data a page passes in (src/lib/seo.ts).
 */
// Fontsource ships one @font-face per subset with the correct unicode-range,
// so the browser downloads the Vietnamese subset only when the page actually
// contains those codepoints — which this page does throughout. Verified these
// files carry a real `vietnamese` subset (U+1EA0-1EF9 etc.), not just latin-ext.
import '@fontsource-variable/playpen-sans/wght.css';
// Literata: weight + optical-size axes, and its true italic for quotes and
// notes (the italic file only downloads on pages that use italic).
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/literata/opsz-italic.css';
import '@fontsource/courgette/400.css';
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/600.css';
import '~/styles/global.css';
import '~/styles/motion.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { site } from '~/content/site';
import { absoluteUrl } from '~/lib/seo';
import heroIllustration from '~/assets/images/hero-reading.png';

interface Props {
  title?: string;
  description?: string;
  /** Link-preview image; defaults to the hero illustration. */
  image?: { src: ImageMetadata; alt: string };
  /** `article` for posts, so previews and crawlers treat them as such. */
  type?: 'website' | 'article';
  /** ISO date, for articles. */
  publishedAt?: string;
  /** schema.org objects from src/lib/seo.ts, one <script> each. */
  structuredData?: readonly Record<string, unknown>[];
}

const {
  title = site.seo.homeTitle,
  description = site.seo.homeDescription,
  image = { src: heroIllustration, alt: site.seo.defaultImageAlt },
  type = 'website',
  publishedAt,
  structuredData = [],
} = Astro.props;

// Pages are built as `tai-lieu.html` but served as `/tai-lieu` (see
// astro.config.mjs), so normalise whatever form the path arrives in.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/(.)\/$/, '$1') || '/';
const canonical = absoluteUrl(path);

// 1200px wide JPEG: the size Facebook and Zalo render large previews at.
const preview = await getImage({ src: image.src, width: 1200, format: 'jpeg' });
const previewUrl = absoluteUrl(preview.src);

/** JSON for a <script> element: `<` escaped so text can never close the tag. */
const toJson = (data: Record<string, unknown>) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Link previews (Open Graph for Facebook/Zalo/Messenger, Twitter card). */}
    <meta property="og:site_name" content={site.seo.siteName} />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={previewUrl} />
    <meta property="og:image:width" content={String(preview.attributes.width)} />
    <meta property="og:image:height" content={String(preview.attributes.height)} />
    <meta property="og:image:alt" content={image.alt} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    <meta name="twitter:card" content="summary_large_image" />

    {structuredData.map((data) => (
      <script is:inline type="application/ld+json" set:html={toJson(data)} />
    ))}

    <script is:inline>
      // Motion gate (FR-029, FR-030). Deliberately BLOCKING and in <head>:
      // it must run before first paint, or content would flash visible and
      // then hide itself.
      //
      // Everything that animates is styled visible by default and only gets a
      // hidden starting state under `.js-motion`. So no JavaScript, or reduced
      // motion, means the content was simply never hidden — the animation can
      // only hide what it is also guaranteed to reveal.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-motion');
      }
    </script>
  </head>
  <body class="min-h-screen antialiased">
    {/* Keyboard users can skip the decorative hero straight to content (FR-031) */}
    <a
      href="#noi-dung"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:text-sprout-800 focus:shadow-lg"
    >
      Bỏ qua tới nội dung chính
    </a>
    <slot name="header" />
    <main>
      <slot />
    </main>

    <script is:inline>
      // Scroll reveal observer. The `js-motion` gate was already decided in
      // <head>; this only drives the reveal itself.
      (function () {
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        if (reduced.matches) return;

        var items = document.querySelectorAll('.reveal');

        // Without IntersectionObserver, drop the hidden state entirely rather
        // than leaving content stranded behind a reveal that can never fire.
        if (!items.length || !('IntersectionObserver' in window)) {
          document.documentElement.classList.remove('js-motion');
          return;
        }

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              // Reveal once. A reveal that reverses on scroll-up would move
              // content while it is being read, which FR-029 prohibits.
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );

        items.forEach(function (item) {
          observer.observe(item);
        });

        // If the visitor turns reduced motion on mid-session, drop every
        // pending hidden state immediately rather than stranding content.
        reduced.addEventListener('change', function (event) {
          if (!event.matches) return;
          document.documentElement.classList.remove('js-motion');
          observer.disconnect();
        });
      })();
    </script>
  </body>
</html>
