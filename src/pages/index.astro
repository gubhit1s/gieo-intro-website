---
/**
 * The home page. The post library has its own routes under src/pages/tai-lieu.
 *
 * Section order: hero → talkshow → materials → footer. The talkshow replaced
 * the team section, and the course section has been removed (FR-001's
 * original order was hero → team → materials → course → footer).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';
import SiteHeader from '~/sections/SiteHeader.astro';
import HeroSection from '~/sections/HeroSection.astro';
import TalkshowSection from '~/sections/TalkshowSection.astro';
import MaterialsSection from '~/sections/MaterialsSection.astro';
import SiteFooter from '~/sections/SiteFooter.astro';
import { getPosts, toMaterialEntry } from '~/lib/posts';
import { absoluteUrl, homeGraph, talkshowEvent } from '~/lib/seo';
import { getImage } from 'astro:assets';
import talkshowPoster from '~/assets/images/talkshow/poster-main.jpg';

const materials = getPosts().map(toMaterialEntry);

// Structured data: who Gieo is, plus the talkshow as an event Google can list.
const poster = await getImage({ src: talkshowPoster, width: 1080, format: 'jpeg' });
const structuredData = [homeGraph(), talkshowEvent(absoluteUrl(poster.src))];
---

<BaseLayout structuredData={structuredData}>
  <SiteHeader slot="header" />
  <HeroSection />
  <TalkshowSection />
  <MaterialsSection entries={materials} />
  <SiteFooter />
</BaseLayout>
