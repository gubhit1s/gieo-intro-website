---
/**
 * Decorative stack of three books with a sprout growing from the top.
 * Ornamental only — aria-hidden, non-interactive (FR-027).
 *
 * Colours are fixed to the decoration-only palette (sprout/sun/blossom
 * 200–400), so `class` is for size, position and animation. Height is
 * 11/12 of `size`.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 48, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 44"
  width={size}
  height={(size * 44) / 48}
  fill="none"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  {/* Bottom book */}
  <g class="text-sprout-400" fill="currentColor">
    <rect x="3" y="33" width="42" height="9" rx="1.5" />
  </g>
  <rect x="8" y="33" width="2" height="9" fill="#fff" opacity="0.45" />
  <rect x="38" y="33" width="2" height="9" fill="#fff" opacity="0.45" />

  {/* Middle book */}
  <g class="text-sun-300" fill="currentColor">
    <rect x="7" y="24" width="34" height="9" rx="1.5" />
  </g>
  <rect x="12" y="24" width="2" height="9" fill="#fff" opacity="0.5" />
  <rect x="34" y="24" width="2" height="9" fill="#fff" opacity="0.5" />

  {/* Top book, slightly askew */}
  <g transform="rotate(-4 22 19.5)">
    <g class="text-blossom-300" fill="currentColor">
      <rect x="4" y="15" width="36" height="9" rx="1.5" />
    </g>
    <rect x="9" y="15" width="2" height="9" fill="#fff" opacity="0.45" />
  </g>

  {/* Sprout */}
  <g class="text-sprout-500">
    <path d="M31 15c0-3 0-6 .5-9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    <path
      d="M31.4 8.5C29 5.2 26 4.6 23.5 5.6c1.6 3 4.4 4 7.9 2.9z"
      fill="currentColor"
      opacity="0.8"
    />
    <path
      d="M31.6 7.5c1.6-3.4 4.4-4.6 7.2-4.2-.9 3.2-3.6 4.8-7.2 4.2z"
      fill="currentColor"
      opacity="0.6"
    />
  </g>
</svg>
