---
/**
 * The Gieo brand mark (FR-025).
 *
 * Concept: a two-leaf sprout rising out of a mound of freshly sown earth —
 * "gieo" means to sow. Shapes are kept simple and heavy so the silhouette
 * still reads at 24px, where the pebbles drop out visually.
 *
 * The sprout uses currentColor (set it with `class`, e.g. text-sprout-600);
 * the earth uses `earthClass` so the mark stays two-tone in every context.
 * public/favicon.svg is a hard-coded copy of this drawing — update both.
 */
interface Props {
  /** Size in px. Works from 24 (footer) to hero scale. */
  size?: number;
  /**
   * When the brand name is already visible beside the mark, pass decorative so
   * the logo is skipped by assistive tech — otherwise the name is announced
   * twice (FR-027, FR-031).
   */
  decorative?: boolean;
  class?: string;
  /** Colour of the earth mound. */
  earthClass?: string;
}

const {
  size = 40,
  decorative = false,
  class: className = '',
  earthClass = 'text-bark-400',
} = Astro.props;

const a11y = decorative
  ? { 'aria-hidden': 'true' as const, focusable: 'false' as const }
  : { role: 'img' as const, 'aria-label': 'Gieo' };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 48 48"
  width={size}
  height={size}
  fill="none"
  class={className}
  {...a11y}
>
  <!-- Earth mound, with a few pale pebbles -->
  <g class={earthClass}>
    <path
      d="M7.5 42C9.4 36.4 15.6 33 24 33s14.6 3.4 16.5 9c.3.8-.3 1.5-1.1 1.5H8.6c-.8 0-1.4-.7-1.1-1.5z"
      fill="currentColor"
    />
  </g>
  <g class="text-bark-200" fill="currentColor">
    <ellipse cx="16" cy="40" rx="1.5" ry="1" />
    <ellipse cx="30.5" cy="38.6" rx="1.2" ry="0.8" />
    <ellipse cx="34.5" cy="41.2" rx="0.9" ry="0.6" />
  </g>
  <!-- Stem -->
  <path d="M24 34c0-5.4-.5-10.6.5-16.5" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" />
  <!-- Left leaf (lighter, smaller) -->
  <path
    d="M23.8 25.5c-1.9-5.8-6.7-9.1-13-8.6.4 6 4.7 10 10.7 10.3 1 0 1.8-.6 2.3-1.7z"
    fill="currentColor"
    opacity="0.6"
  />
  <!-- Right leaf -->
  <path
    d="M24.5 19.5c1.6-7.5 7.4-11.9 15.4-11.6-.1 7.8-5.4 13.1-12.9 13.8-1 .1-2-.6-2.5-2.2z"
    fill="currentColor"
  />
</svg>
