---
/**
 * Decorative lavender sprig: a slim stem with buds stacked along the top half,
 * shrinking towards the tip. Ornamental only — aria-hidden, non-interactive
 * (FR-027). Height is twice `size`.
 *
 * `class` colours the stem and leaves; buds alternate two lavender tones.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 24, class: className = '' } = Astro.props;

// Pairs of buds from y=24 (largest) up to the tip at y=4.
const buds = Array.from({ length: 7 }, (_, i) => {
  const y = 24 - i * 3.1;
  const scale = 1 - i * 0.09;
  return [
    { cx: 10.4, cy: y, rx: 1.7 * scale, ry: 2.5 * scale, deg: -24 },
    { cx: 13.6, cy: y - 1.4, rx: 1.7 * scale, ry: 2.5 * scale, deg: 24 },
  ];
}).flat();
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 48"
  width={size}
  height={size * 2}
  fill="none"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <path d="M12 47c0-14 0-28 0-42" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
  <path d="M11.8 42c-3.4-2.4-5-6-5.2-10 3 2 4.8 5.4 5.2 10z" fill="currentColor" opacity="0.7" />
  <path d="M12.2 38c3.2-2 4.8-5.2 5-9-2.8 1.8-4.6 4.8-5 9z" fill="currentColor" opacity="0.55" />
  {
    buds.map((b, i) => (
      <ellipse
        cx={b.cx}
        cy={b.cy.toFixed(2)}
        rx={b.rx.toFixed(2)}
        ry={b.ry.toFixed(2)}
        class={i % 2 ? 'text-lavender-300' : 'text-lavender-400'}
        fill="currentColor"
        transform={`rotate(${b.deg} ${b.cx} ${b.cy.toFixed(2)})`}
      />
    ))
  }
</svg>
