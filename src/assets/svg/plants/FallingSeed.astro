---
/** Decorative falling seed. Ornamental only — aria-hidden, non-interactive (FR-027). */
interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 16 16"
  width={size}
  height={size}
  fill="none"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <ellipse cx="8" cy="8" rx="4" ry="6" fill="currentColor" opacity="0.7" transform="rotate(-20 8 8)" />
  <path d="M8 3.5c1.4 2.2 1.4 6.3 0 9" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" opacity="0.5" />
</svg>
