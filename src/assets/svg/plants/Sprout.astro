---
/** Decorative sprout. Ornamental only — aria-hidden, non-interactive (FR-027). */
interface Props {
  size?: number;
  class?: string;
}
const { size = 48, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 32 32"
  width={size}
  height={size}
  fill="none"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <path d="M16 28V14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  <path
    d="M16 17c-1.1-3.7-4.1-5.6-7.7-5.5 0 3.7 2.3 6.6 5.9 7.1.7.1 1.3-.1 1.8-.6z"
    fill="currentColor"
    opacity="0.5"
  />
  <path
    d="M16 15c1.2-4.1 4.5-6.2 8.5-6 0 4.1-2.6 7.2-6.5 7.8-.8.1-1.5-.2-2-.6z"
    fill="currentColor"
    opacity="0.8"
  />
</svg>
