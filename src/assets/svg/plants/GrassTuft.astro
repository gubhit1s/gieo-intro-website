---
/** Decorative grass tuft. Ornamental only — aria-hidden, non-interactive (FR-027). */
interface Props {
  size?: number;
  class?: string;
}
const { size = 56, class: className = '' } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 32"
  width={size}
  height={size / 2}
  fill="none"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  <path d="M8 32C8 22 11 15 18 10" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.5" />
  <path d="M20 32C20 19 24 11 32 5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" opacity="0.75" />
  <path d="M32 32C32 21 36 14 44 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity="0.55" />
  <path d="M44 32C44 24 48 18 55 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" opacity="0.4" />
</svg>
