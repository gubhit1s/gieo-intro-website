---
/**
 * Hero — User Story 1 (FR-004 … FR-007).
 *
 * The single <h1> and two action buttons, within the first viewport. The
 * brand mark and name sit in SiteHeader above it. The headline text is rendered into the static HTML by the
 * island's server render, so it is present before any JavaScript executes.
 */
import Sprout from '~/assets/svg/plants/Sprout.astro';
import LeafPair from '~/assets/svg/plants/LeafPair.astro';
import WildFlower from '~/assets/svg/plants/WildFlower.astro';
import Blossom from '~/assets/svg/plants/Blossom.astro';
import HeroHeadline from '~/components/astro/HeroHeadline.astro';
import HeroActions from '~/components/astro/HeroActions.astro';
---

<section
  id="gioi-thieu"
  aria-labelledby="gieo-hero-heading"
  class="relative flex min-h-[calc(100svh-var(--header-h))] flex-col overflow-hidden bg-gradient-to-b from-sprout-100 to-sprout-50"
>
  {/* Decorative plants, kept to the left and right edges so they never
      overlap the centred text column (FR-026, FR-027). The flowers need the
      side room of a 1024px+ screen; below that only the small sprigs show. */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 select-none">
    <LeafPair
      size={104}
      class="anim-drift absolute -left-6 top-24 hidden text-sprout-300 opacity-70 sm:block lg:left-10"
    />
    <Sprout
      size={76}
      class="anim-sway anim-delay-1 absolute right-4 top-32 hidden text-sprout-400 opacity-60 sm:block lg:right-20"
    />

    <WildFlower
      size={28}
      class="anim-sway anim-delay-1 absolute left-[6%] top-[54%] hidden text-sprout-400 lg:block"
    />
    <WildFlower
      size={20}
      class="anim-sway anim-delay-3 absolute left-[9%] top-[60%] hidden text-sprout-300 lg:block"
      petalClass="text-sun-200"
    />
    <Blossom size={16} class="absolute left-[11%] top-[50%] hidden text-sun-300 lg:block" />

    <WildFlower
      size={26}
      class="anim-sway anim-delay-2 absolute right-[7%] top-[58%] hidden text-sprout-400 lg:block"
    />
    <Blossom size={14} class="absolute right-[10%] top-[54%] hidden text-sun-200 lg:block" />
  </div>

  <div
    class="section-shell relative z-10 flex flex-1 flex-col items-center justify-center py-20 text-center"
  >
    {/* The brand lockup lives in SiteHeader, directly above. */}
    <HeroHeadline />

    <div class="mt-10 w-full">
      <HeroActions />
    </div>
  </div>
</section>
