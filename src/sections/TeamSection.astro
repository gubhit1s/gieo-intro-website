---
/**
 * Team — User Story 2 (FR-008 … FR-012).
 *
 * Carries the #noi-dung anchor: this is the first real content after the hero,
 * so it is where the skip link and the scroll cue both land.
 */
import { site } from '~/content/site';
import TeamMemberCard from '~/components/astro/TeamMemberCard.astro';
import ScrollReveal from '~/components/astro/ScrollReveal.astro';
import LeafPair from '~/assets/svg/plants/LeafPair.astro';
import WildFlower from '~/assets/svg/plants/WildFlower.astro';
import Daisy from '~/assets/svg/plants/Daisy.astro';
import Tulip from '~/assets/svg/plants/Tulip.astro';
import Lavender from '~/assets/svg/plants/Lavender.astro';
---

{/* Background: see SECTION BACKGROUNDS in global.css. */}
<section
  id="noi-dung"
  aria-labelledby="gieo-team-heading"
  class="relative overflow-hidden bg-gradient-to-b from-sprout-50 to-sun-50 py-20 sm:py-28"
>
  {/* Flowers sit in the side gutters, which are only wide enough from 1280px. */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 select-none">
    <LeafPair
      size={88}
      class="anim-drift anim-delay-1 absolute -right-4 top-10 hidden text-sprout-200 opacity-70 md:block"
    />
    <WildFlower
      size={35}
      class="anim-sway anim-delay-2 absolute left-5 top-[46%] hidden text-sprout-400 xl:block"
    />
    <Daisy
      size={27}
      class="anim-sway absolute left-14 top-[52%] hidden text-sprout-400 xl:block"
    />
    <Tulip
      size={30}
      class="anim-sway anim-delay-1 absolute right-6 top-[56%] hidden text-sprout-400 xl:block"
    />
    <Lavender
      size={24}
      class="anim-sway anim-delay-3 absolute right-14 top-[60%] hidden text-sprout-300 xl:block"
    />
  </div>

  <div class="section-shell relative z-10">
    <h2
      id="gieo-team-heading"
      class="text-center font-display text-3xl font-semibold text-sprout-900 sm:text-4xl"
    >
      {site.team.heading}
    </h2>

    <div class="mt-12 grid gap-6 md:grid-cols-2 md:gap-8">
      {
        site.team.members.map((member, index) => (
          <ScrollReveal delay={index * 0.12} class="h-full">
            <TeamMemberCard member={member} />
          </ScrollReveal>
        ))
      }
    </div>
  </div>
</section>
