---
/** Footer — User Story 5 (FR-020 … FR-023). */
import { site } from '~/content/site';
import GieoLogo from '~/assets/svg/GieoLogo.astro';
import SocialLink from '~/components/astro/SocialLink.astro';
import WildFlower from '~/assets/svg/plants/WildFlower.astro';
import Tulip from '~/assets/svg/plants/Tulip.astro';
import Daisy from '~/assets/svg/plants/Daisy.astro';
import Lavender from '~/assets/svg/plants/Lavender.astro';

const year = new Date().getFullYear();
---

{/* Background: see SECTION BACKGROUNDS in global.css. No top border — the
    gradient carries on from the course section without a seam. */}
<footer
  id="lien-he"
  aria-labelledby="gieo-footer-heading"
  class="relative overflow-hidden bg-gradient-to-b from-sprout-50 to-sprout-100 py-14"
>
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 select-none">
    <WildFlower
      size={32}
      class="anim-sway anim-delay-1 absolute left-[10%] top-1/3 hidden text-sprout-400 md:block"
    />
    <Tulip
      size={27}
      class="anim-sway anim-delay-2 absolute left-[13%] top-[40%] hidden text-sprout-400 md:block"
    />
    <Lavender
      size={27}
      class="anim-sway anim-delay-3 absolute right-[13%] top-[38%] hidden text-sprout-400 md:block"
    />
    <Daisy
      size={30}
      class="anim-sway anim-delay-1 absolute right-[10%] top-1/3 hidden text-sprout-400 md:block"
    />
  </div>

  <div class="section-shell relative z-10 flex flex-col items-center gap-8 text-center">
    <div class="flex flex-col items-center gap-3">
      <GieoLogo size={40} decorative class="text-sprout-600" />
      <h2 id="gieo-footer-heading" class="font-brand text-4xl text-sprout-800">
        {site.brand.name}
      </h2>
      <p class="text-sm text-ink-muted">{site.brand.tagline}</p>
    </div>

    <ul class="flex items-center gap-4">
      {
        site.social.map((link) => (
          <li>
            <SocialLink link={link} />
          </li>
        ))
      }
    </ul>

    <p class="text-xs text-ink-muted">© {year} {site.brand.name}</p>
  </div>
</footer>
