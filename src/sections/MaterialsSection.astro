---
/**
 * Free materials — User Story 4 (FR-013 … FR-016).
 *
 * A preview of the post library, laid out like a literary publication: the
 * first post is featured, up to two more follow as a quieter list, and
 * whitespace rather than card borders separates them. The full library is its
 * own page at /tai-lieu.
 *
 * Entries arrive as props (see src/pages/index.astro) rather than being read
 * from the content collection here, so the section renders in unit tests.
 */
import { site } from '~/content/site';
import type { MaterialEntry } from '~/content/types';
import MaterialCard from '~/components/astro/MaterialCard.astro';
import ScrollReveal from '~/components/astro/ScrollReveal.astro';
import WildFlower from '~/assets/svg/plants/WildFlower.astro';
import Sprout from '~/assets/svg/plants/Sprout.astro';
import Tulip from '~/assets/svg/plants/Tulip.astro';
import Daisy from '~/assets/svg/plants/Daisy.astro';
import Lavender from '~/assets/svg/plants/Lavender.astro';

interface Props {
  /** Posts in display order. The first is featured; at most three show. */
  entries: readonly MaterialEntry[];
}

const [featured, ...rest] = Astro.props.entries.slice(0, 3);
---

{/* Background: see SECTION BACKGROUNDS in global.css. */}
<section
  id="tai-lieu"
  aria-labelledby="gieo-materials-heading"
  class="relative overflow-hidden bg-gradient-to-b from-sun-50 to-sprout-100 py-20 sm:py-28"
>
  {/* Plants sit in the side gutters, which are only wide enough from 1280px. */}
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 select-none">
    <Sprout
      size={56}
      class="anim-sway anim-delay-3 absolute right-6 top-10 hidden text-sprout-300 opacity-70 lg:block"
    />
    <WildFlower
      size={35}
      class="anim-sway anim-delay-1 absolute right-6 top-[52%] hidden text-sprout-400 xl:block"
    />
    <Lavender
      size={27}
      class="anim-sway absolute right-14 top-[58%] hidden text-sprout-400 xl:block"
    />
    <Tulip
      size={30}
      class="anim-sway anim-delay-2 absolute left-6 top-[44%] hidden text-sprout-400 xl:block"
      petalClass="text-lavender-300"
    />
    <Daisy
      size={24}
      class="anim-sway anim-delay-3 absolute left-14 top-[52%] hidden text-sprout-300 xl:block"
    />
  </div>

  <div class="section-shell relative z-10">
    <div class="text-center">
      <h2
        id="gieo-materials-heading"
        class="font-serif text-3xl font-medium text-sprout-900 sm:text-4xl"
      >
        {site.materials.heading}
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-base text-ink-muted">{site.materials.subtitle}</p>
    </div>

    {featured && (
      <>
        {/* Lead article on the left, the rest stacked beside it on wide screens. */}
        <div class="mt-14 grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
          <ScrollReveal class="lg:col-span-7">
            <MaterialCard entry={featured} featured />
          </ScrollReveal>
          <div class="flex flex-col gap-12 lg:col-span-5">
            {rest.map((entry, index) => (
              <ScrollReveal delay={(index + 1) * 0.1}>
                <MaterialCard entry={entry} />
              </ScrollReveal>
            ))}
          </div>
        </div>
      </>
    )}

    <div class="mt-14 text-center">
      <a
        href="/tai-lieu"
        class="inline-flex items-center gap-2 rounded-full px-5 py-2.5 font-semibold text-sprout-800 ring-1 ring-sprout-300 transition-colors hover:bg-white/70 hover:text-sprout-900"
      >
        {site.materials.viewAllLabel}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
